# Example terraform variables for github stack
repository_owner               = "your-org"
repository_name                = "your-repo"
workload_identity_provider     = "projects/123456789012/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-provider"
ci_service_account_email       = "my-agent-service-ci@your-gcp-project-id.iam.gserviceaccount.com"
deployer_service_account_email = "my-agent-service-deployer@your-gcp-project-id.iam.gserviceaccount.com"
gcp_project_id                 = "your-gcp-project-id"
gcp_region                     = "us-central1"
tf_state_bucket                = "your-gcp-project-id-tfstate"
environment_name               = "production"
