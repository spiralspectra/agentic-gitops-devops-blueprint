variable "repository_owner" {
  type        = string
  description = "GitHub repository owner (user or organization)."
}

variable "repository_name" {
  type        = string
  description = "GitHub repository name."
}

variable "workload_identity_provider" {
  type        = string
  description = "Full resource name of the Workload Identity Provider generated by single-project stack."
}

variable "ci_service_account_email" {
  type        = string
  description = "Email of the CI service account."
}

variable "deployer_service_account_email" {
  type        = string
  description = "Email of the Deployer service account."
}

variable "gcp_project_id" {
  type        = string
  description = "Google Cloud Project ID."
}

variable "gcp_region" {
  type        = string
  description = "Google Cloud region."
  default     = "us-central1"
}

variable "tf_state_bucket" {
  type        = string
  description = "GCS bucket storing Terraform state."
}

variable "environment_name" {
  type        = string
  description = "GitHub Actions environment name for deployment history."
  default     = "production"
}

variable "required_status_checks" {
  type        = list(string)
  description = "Strict check contexts required before merge to main."
  default = [
    "lint",
    "terraform-plan",
    "tests",
    "evals",
    "frontend-build",
  ]
}

variable "enforce_admins" {
  type        = bool
  description = "Whether to enforce branch protection on administrators."
  default     = true
}

variable "required_approving_review_count" {
  type        = number
  description = "Number of required approving reviews on pull requests."
  default     = 1
}
